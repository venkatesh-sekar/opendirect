{
  "name": "@opendirect/desktop",
  "private": true,
  "version": "0.0.0",
  "description": "OpenDirect — a local-first desktop workspace for generative media.",
  "author": {
    "name": "OpenDirect",
    "email": "releases@opendirect.app"
  },
  "homepage": "https://github.com/REPLACE_WITH_GITHUB_OWNER/opendirect",
  "main": "dist/main/index.js",
  "scripts": {
    "build": "pnpm build:main",
    "build:main": "tsup",
    "dist": "electron-builder --publish never",
    "dist:dir": "electron-builder --dir --publish never",
    "dev": "cross-env NODE_ENV=development electron dist/main/index.js",
    "lint": "eslint",
    "start": "electron dist/main/index.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "electron-serve": "3.0.1",
    "electron-store": "11.0.2",
    "electron-log": "5.4.4",
    "electron-updater": "6.8.9",
    "better-sqlite3": "13.0.3",
    "drizzle-orm": "0.45.2",
    "p-queue": "9.3.3",
    "replicate": "1.4.0",
    "@openrouter/sdk": "1.2.128",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@workspace/eslint-config": "*",
    "concurrently": "10.0.5",
    "cross-env": "10.1.0",
    "drizzle-kit": "0.31.10",
    "electron": "44.4.1",
    "electron-builder": "26.15.3",
    "eslint": "^9",
    "globals": "^17.6.0",
    "tsup": "8.5.1",
    "typescript": "5.9.3",
    "vitest": "^5.0.1",
    "wait-on": "9.1.0"
  }
}
