{
  "extends": "@workspace/typescript-config/base.json",
  "compilerOptions": {
    "noEmit": true,
    "types": ["node", "vitest/globals"]
  },
  "include": ["vitest.config.ts", "vitest.setup.ts", "test/**/*.ts"],
  // These import the desktop provider adapters, so they need this config's
  // Node types; `files` is not subject to `exclude`.
  "files": [
    "packages/contract/src/registry/check.test.ts",
    "packages/contract/src/registry/family-schema.test.ts",
    "packages/contract/src/registry/suggest.test.ts"
  ],
  "exclude": ["node_modules", "apps", "packages"]
}
