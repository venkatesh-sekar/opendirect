# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
coverage

# next.js
.next/
out/

# production
build
dist
# ...except electron-builder's buildResources dir, which is source, not output.
!apps/desktop/build/

# turbo
.turbo

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# build
release/

# local data
*.db
*.db-journal
*.db-wal
*.db-shm
.opendirect/
# drizzle-kit studio scratch database (see apps/desktop/drizzle.config.ts)
apps/desktop/.drizzle/

# sandbox bind-mount stub (cannot be deleted from inside the sandbox)
/opendirect/

# sandbox bind-mounts at the repo root (not project files)
/.bashrc
/.bash_profile
/.profile
/.zshrc
/.zprofile
/.gitconfig
/.gitmodules
/.ripgreprc
/.mcp.json
/.idea
/.vscode
/.claude/
