        "last_frame": {
          "field": "end_image",
          "kind": "image",
          "label": "Last frame"
        }
      },
      "controls": {
        "prompt": {
          "field": "prompt"
        },
        "negative_prompt": {
          "field": "negative_prompt"
        },
        "aspect_ratio": {
          "field": "aspect_ratio"
        },
        "duration": {
          "field": "duration"
        }
      }
    }
  ]
}
